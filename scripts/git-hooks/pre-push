#!/bin/sh
# Block pushes whose commits contain local credentials or tenant data.
root=$(git rev-parse --show-toplevel)
py="$root/venv/bin/python"; [ -x "$py" ] || py=python3
remote="$1"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue          # branch deletion
    if [ "$remote_sha" = "$zero" ]; then             # new remote branch: compare with remote default branch
        base=$(git merge-base "$local_sha" "refs/remotes/$remote/HEAD" 2>/dev/null \
               || git merge-base "$local_sha" "refs/remotes/$remote/main" 2>/dev/null \
               || git hash-object -t tree /dev/null)
    else
        base="$remote_sha"
    fi
    "$py" "$root/scripts/check_sensitive.py" --range "$base..$local_sha" || status=1
done
exit $status
