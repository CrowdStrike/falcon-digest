# CrowdStrike Falcon MCP — Environment Variables
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env

# ── CrowdStrike Falcon API (required) ───────────────────────────
# Create an API client at: Falcon Console → API Clients & Keys
# Required scopes: alerts:read, cases:read, detections:read,
#   hosts:read, spotlight-vulnerabilities:read, threatgraph:read
#
# Recommended additional scopes for full CISO dashboard:
#   incidents:read       — CrowdScore gauge, Incidents summary
#   discover:read        — Asset Inventory (managed/unmanaged/IoT/accounts)
#   exposure-management:read — External Attack Surface

FALCON_CLIENT_ID=
FALCON_CLIENT_SECRET=

# Your CrowdStrike cloud region:
#   US-1:   https://api.crowdstrike.com
#   US-2:   https://api.us-2.crowdstrike.com
#   US-3:   https://api.us-3.crowdstrike.com
#   EU-1:   https://api.eu-1.crowdstrike.com
#   GOV-1:  https://api.laggar.gcw.crowdstrike.com
#   GOV-2:  https://api.us-gov-2.crowdstrike.mil
FALCON_BASE_URL=https://api.crowdstrike.com

# ── LLM / AI Chat (optional) ────────────────────────────────────
# The AI chat feature requires an LLM endpoint compatible with
# Anthropic Messages API or OpenAI Chat Completions API format.
# Leave blank to use the dashboards without AI chat.
#
# Examples:
#   Anthropic API:          https://api.anthropic.com
#   OpenAI API:             https://api.openai.com
#   Any compatible proxy:   https://your-proxy

LLM_ENDPOINT=
LLM_API_KEY=

# Provider: "anthropic" (default) or "openai"
# LLM_PROVIDER=anthropic

# Model override (defaults: claude-4-6-opus for anthropic, gpt-4o for openai)
# LLM_MODEL=
